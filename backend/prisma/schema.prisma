// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Room {
  id       Int      @id @default(autoincrement())
  data     String
}

model Book {
  id             Int      @id @default(autoincrement())
  id_room        Int
  start          String
  end            String
}
