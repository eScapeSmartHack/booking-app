generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Room {
  id   Int    @id @default(autoincrement())
  data String
}

model Book {
  id      Int    @id @default(autoincrement())
  id_room Int
  id_user Int
  date    String
  start   String
  end     String
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  password String
  avatar   String
}
