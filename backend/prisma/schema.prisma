generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Room {
  id   Int    @id @default(autoincrement())
  data String
}

model Book {
  id      Int    @id @default(autoincrement())
  id_room Int
  id_user Int
  date    String
  start   String
  end     String
  status  String @default("active") // "pending", "approved", "rejected", or "active" (auto-approved)
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  password String
  avatar   String
  type     String @default("EMPLOYEE")
  mood     String @default("happy") // "happy", "sad", "stressed", "tired", "focused"
  teamMemberships TeamMember[]
}

model Team {
  id          Int    @id @default(autoincrement())
  name        String
  description String?
  members     TeamMember[]
}

model TeamMember {
  id      Int   @id @default(autoincrement())
  userId  Int
  teamId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}
